# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-contextforge-super-secret-key-2026
ALLOWED_HOSTS=*

# PostgreSQL Database (Optional for docker-compose; leaves SQLite fallback if empty)
POSTGRES_DB=contextforge
POSTGRES_USER=contextforge
POSTGRES_PASSWORD=contextforge_secure_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_ALWAYS_EAGER=False

# AI Normalization Providers (Optional: system uses high-performance Heuristic Cleaner if empty)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=auto

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000/api
